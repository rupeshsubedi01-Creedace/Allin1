# Copy to .env and adjust, or set these as environment variables in your host.

# Where SQLite history + downloaded files are stored.
# Use an absolute path on your persistent volume in production.
ALLIN1_DATA_DIR=/app/data

# Port to bind. Most platforms inject PORT automatically.
PORT=8000

# Comma-separated list of browser origins allowed to call the API.
# The Android app and the bundled PWA are same-origin and do not need this.
# Use * to allow any origin (the API is public and holds no credentials).
ALLIN1_CORS_ORIGINS=*

# Override the ffmpeg binary if it is not on PATH.
# FFMPEG_BINARY=/usr/bin/ffmpeg

# Number of uvicorn workers. Keep at 1: job state lives in-process.
WEB_CONCURRENCY=1
