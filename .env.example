# Copy to .env and adjust, or set these as environment variables in your host.

# Where SQLite history + downloaded files are stored.
# Use an absolute path on your persistent volume in production.
ALLIN1_DATA_DIR=/app/data

# Port to bind. Most platforms inject PORT automatically.
PORT=8000

# Comma-separated list of browser origins allowed to call the API.
# The Android app and the bundled PWA are same-origin and do not need this.
# Use * to allow any origin (the API is public and holds no credentials).
ALLIN1_CORS_ORIGINS=*

# Override the ffmpeg binary if it is not on PATH.
# FFMPEG_BINARY=/usr/bin/ffmpeg

# Number of uvicorn workers. Keep at 1: job state lives in-process.
WEB_CONCURRENCY=1

# ---------------------------------------------------------------------------
# Security. Leave ALLIN1_API_KEY unset for local/personal use; SET IT when the
# app is reachable by other people. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# ---------------------------------------------------------------------------

# Require this key on every API route (except /api/health). Minimum 16 chars.
# Clients may send it as `X-API-Key: <key>`, `Authorization: Bearer <key>`,
# or `?key=<key>` (the last one is what the PWA uses for SSE progress streams
# and file-download links, which cannot set headers).
ALLIN1_API_KEY=

# Refuse media bigger than this many megabytes (0/unset = unlimited).
# 2048 is a sane value for a public host.
ALLIN1_MAX_DOWNLOAD_MB=0

# Delete downloaded files older than this many hours (0/unset = keep forever).
# History metadata is kept so "Re-download" still works.
ALLIN1_FILE_TTL_HOURS=0

# TESTING ONLY: allow the server to fetch private/loopback addresses
# (127.0.0.1, 10.x, 169.254.169.254, *.internal...). The offline test-suite
# needs this; never enable it on a host other people can reach.
ALLIN1_ALLOW_PRIVATE_URLS=false
